<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MonarchD" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/panel_black</item>
        <item name="android:colorBackground">@color/panel_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.MonarchD.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wood_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.MonarchD</item>
    </style>

</resources>
