    <string name="settings_version">Version</string>
    <string name="settings_credits">Monarch D is an original real-time emulation of a classic 1970s monophonic ladder-filter synthesizer. Every sound is generated on your device — no samples, no network.</string>

    <string name="help_title">How to play</string>
    <string name="help_knobs">Drag a knob up or down to shape the sound. Double-tap to return it to its default.</string>
    <string name="help_pages">Swipe the panel sideways, or tap the engraved tabs, to move between oscillator, mixer, filter, envelope and performance controls.</string>
    <string name="help_wheels">The left wheel bends pitch and springs back. The right wheel adds vibrato and filter movement and stays where you leave it.</string>
    <string name="help_keys">Slide across the keys for a glissando. Use the octave arrows to travel the full range.</string>
    <string name="help_audio">Headphones or a wired speaker give the lowest latency and the fullest bass.</string>
